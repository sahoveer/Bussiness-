        "stockAfter": { "type": "number" },
        "movementType": { "type": "string" },
        "reason": { "type": "string" },
        "referenceId": { "type": "string" },
        "performedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "businessId", "productId", "productName", "batchNumber", "quantityChange",
        "stockAfter", "movementType", "reason", "referenceId", "performedBy", "createdAt"
      ]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profile and Udhaar (credit) ledger summary.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "outstandingBalance": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "businessId", "name", "phone", "address", "outstandingBalance",
        "totalPurchases", "notes", "createdAt", "updatedAt"
      ]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier profile and payable balance summary.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "payableBalance": { "type": "number" },
        "totalPurchased": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "businessId", "name", "companyName", "phone", "address",
        "payableBalance", "totalPurchased", "createdAt", "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating expense record.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "businessId": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "POSTED", "ADJUSTED"] },
