      ]
    },
    "Employee": {
      "title": "Employee",
      "description": "Shop employee with role-based permissions.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "permissionsCsv": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "businessId", "name", "phone", "email", "role",
        "permissionsCsv", "isActive", "createdAt", "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only security and financial audit log.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "businessId": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "details": { "type": "string" },
        "performedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid", "businessId", "action", "module", "details", "performedBy", "createdAt"
      ]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Multi-tenant business profiles owned by authenticated users."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products and medicines scoped to businessId and ownerUid."
    },
    "/medicine_batches/{batchId}": {
      "schema": "MedicineBatch",
      "description": "Pharmacy batch inventory records."
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "POS invoices and sales transactions."
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Supplier purchase invoices."
    },
    "/stock_movements/{movementId}": {
      "schema": "StockMovement",
      "description": "Append-only stock movement ledger."
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customers and Udhaar balances."
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Suppliers and payable balances."
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Business operating expenses."
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Employees and role-based access definitions."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only audit trail."
    }
  }
}
